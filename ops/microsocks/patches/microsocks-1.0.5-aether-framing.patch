+/* SOCKS5 runs over a byte stream, so a single recv() is not guaranteed to
+   return a complete protocol frame. Read exactly the requested number of
+   bytes before parsing a field-sized frame. */
+static int recv_full(int fd, unsigned char *buf, size_t len) {
+	size_t received = 0;
+	while(received < len) {
+		ssize_t n = recv(fd, buf + received, len - received, 0);
+		if(n == 0) return -1;
+		if(n < 0) {
+			if(errno == EINTR) continue;
+			return -1;
+		}
+		received += (size_t) n;
+	}
+	return 0;
+}
+
+static int recv_auth_methods(int fd, unsigned char *buf, size_t cap, size_t *len) {
+	if(cap < 2 || recv_full(fd, buf, 2)) return -1;
+	size_t total = 2 + (size_t) buf[1];
+	if(buf[1] == 0 || total > cap) return -1;
+	if(recv_full(fd, buf + 2, total - 2)) return -1;
+	*len = total;
+	return 0;
+}
+
+static int recv_credentials(int fd, unsigned char *buf, size_t cap, size_t *len) {
+	if(cap < 2 || recv_full(fd, buf, 2)) return -1;
+	size_t username_len = buf[1];
+	size_t password_len_offset = 2 + username_len;
+	if(password_len_offset + 1 > cap) return -1;
+	if(recv_full(fd, buf + 2, username_len + 1)) return -1;
+	size_t total = password_len_offset + 1 + (size_t) buf[password_len_offset];
+	if(total > cap) return -1;
+	if(recv_full(fd, buf + password_len_offset + 1,
+	             total - password_len_offset - 1)) return -1;
+	*len = total;
+	return 0;
+}
+
+static int recv_connect_request(int fd, unsigned char *buf, size_t cap, size_t *len) {
+	if(cap < 4 || recv_full(fd, buf, 4)) return -1;
+	size_t total;
+	switch(buf[3]) {
+		case 1: /* IPv4 address plus port */
+			total = 4 + 4 + 2;
+			break;
+		case 4: /* IPv6 address plus port */
+			total = 4 + 16 + 2;
+			break;
+		case 3: /* one-byte domain length, domain, and port */
+			if(cap < 5 || recv_full(fd, buf + 4, 1)) return -1;
+			total = 4 + 1 + (size_t) buf[4] + 2;
+			break;
+		default:
+			/* The parser will return EC_ADDRESSTYPE_NOT_SUPPORTED. */
+			buf[4] = 0;
+			*len = 5;
+			return 0;
+	}
+	if(total > cap) return -1;
+	size_t received = buf[3] == 3 ? 5 : 4;
+	if(recv_full(fd, buf + received, total - received)) return -1;
+	*len = total;
+	return 0;
+}
