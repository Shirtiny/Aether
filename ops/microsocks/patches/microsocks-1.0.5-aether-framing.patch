+static void send_full(int fd, const void *data, size_t len) {
+	const unsigned char *buf = data;
+	size_t sent = 0;
+	while(sent < len) {
+		ssize_t n = write(fd, buf + sent, len - sent);
+		if(n < 0 && errno == EINTR) continue;
+		if(n <= 0) return;
+		sent += (size_t) n;
+	}
+}
